---
/**
 * TOC — table of contents generated from article headings.
 * Renders a sticky sidebar TOC on desktop, collapsible on mobile.
 */
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  items.length > 1 && (
    <nav class="toc" aria-label="Table of contents">
      <div class="toc__title">On this page</div>
      <ul>
        {items.map((h) => (
          <li class={`toc__item toc__item--h${h.depth}`}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc {
    font-size: 0.9rem;
    border-left: 3px solid var(--border);
    padding-left: 1rem;
    margin: 1.5rem 0;
  }
  .toc__title {
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text);
  }
  .toc ul { list-style: none; margin: 0; padding: 0; }
  .toc__item { margin-bottom: 0.35rem; }
  .toc__item--h3 { padding-left: 1rem; }
  .toc__item a { color: var(--muted); }
  .toc__item a:hover { color: var(--accent); text-decoration: none; }
</style>
