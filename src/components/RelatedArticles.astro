---
/**
 * RelatedArticles — related article cards.
 * Pass a list of articles (title, url, description, category).
 */
interface Related {
  title: string;
  url: string;
  description: string;
  category?: string;
}

interface Props {
  articles: Related[];
  title?: string;
}

const { articles, title = 'Related Guides' } = Astro.props;
---

{
  articles.length > 0 && (
    <section class="related" aria-label={title}>
      <h2 class="related__title">{title}</h2>
      <div class="related__grid">
        {articles.map((a) => (
          <a href={a.url} class="related__card">
            {a.category && <span class="related__cat">{a.category}</span>}
            <h3 class="related__card-title">{a.title}</h3>
            <p class="related__desc">{a.description}</p>
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  .related { margin: 2.5rem 0; }
  .related__title { font-size: 1.3rem; margin-bottom: 1rem; }
  .related__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }
  .related__card {
    display: block;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem;
    color: var(--text);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }
  .related__card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .related__cat {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    font-weight: 600;
  }
  .related__card-title { font-size: 1rem; margin: 0.35rem 0; }
  .related__desc {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
