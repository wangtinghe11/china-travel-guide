---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About China Travel Guide',
    url: new URL('/about/', Astro.site).href,
  },
];
---

<BaseLayout
  title="About Us — China Travel Guide"
  description="We're a team of locals and long-term expats in China, writing honest travel guides so you can skip the tourist traps and experience the real China."
  canonicalPath="/about/"
  jsonLd={jsonLd}
>
  <div class="container">
    <Breadcrumb
      crumbs={[
        { name: 'Home', url: '/' },
        { name: 'About', url: '/about/' },
      ]}
    />

    <article class="about">
      <h1>About China Travel Guide</h1>

      <section>
        <h2>Who We Are</h2>
        <p>
          We're a small team based in China who love showing visitors around our country.
          Most English-language China content online is written by people who've never been —
          we live here, ride the trains, eat the food, and deal with the same visa offices and
          payment apps you will.
        </p>
      </section>

      <section>
        <h2>What We Cover</h2>
        <ul>
          <li><strong>Practical guides</strong> — visa rules, Alipay/WeChat Pay, high-speed rail, eSIMs</li>
          <li><strong>10 city guides</strong> — Beijing, Shanghai, Xi'an, Chengdu, Chongqing, Guangzhou, Shenzhen, Hangzhou, Guilin, Zhangjiajie</li>
          <li><strong>Local-level detail</strong> — the stuff guidebooks miss, updated as policies change</li>
        </ul>
      </section>

      <section>
        <h2>How We Make Money</h2>
        <p>
          We keep the site free. We earn a small commission when you book hotels or tours through
          our partner links (at no extra cost to you), and we may show ads in the future.
          Partner links are always marked, and they never affect our recommendations.
        </p>
      </section>

      <section id="contact">
        <h2>Contact</h2>
        <p>
          Questions, corrections, or partnership ideas? Email us at
          <a href="mailto:hello@chinatravelguide.co">hello@chinatravelguide.co</a>.
          We read everything and update guides when policies change.
        </p>
      </section>

      <section id="privacy">
        <h2>Privacy Policy</h2>
        <p>
          We don't sell your data. We use privacy-friendly analytics to understand which guides help
          people. If we add advertising or affiliate tracking, this page will be updated to explain
          exactly what's collected.
        </p>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .about { max-width: 760px; margin: 1.5rem auto; }
  .about h1 { font-size: 2rem; margin: 0 0 1.5rem; }
  .about section { margin-bottom: 2rem; }
  .about h2 { font-size: 1.3rem; }
  .about ul { padding-left: 1.4rem; }
  .about li { margin-bottom: 0.5rem; }
</style>
