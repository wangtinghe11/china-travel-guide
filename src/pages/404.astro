---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — China Travel Guide"
  description="The page you're looking for doesn't exist. Browse our China travel guides instead."
  canonicalPath="/404/"
>
  <div class="container">
    <div class="nf">
      <h1>404 — Page Not Found</h1>
      <p>Sorry, that page doesn't exist (or has moved).</p>
      <p>
        <a href="/">← Back to Home</a> · <a href="/cities/">Browse Cities</a> · <a href="/guides/">Browse Guides</a>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .nf { text-align: center; padding: 4rem 1rem; }
  .nf h1 { font-size: 2rem; }
  .nf p { color: var(--muted); }
</style>
