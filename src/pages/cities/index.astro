---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const cities = (await getCollection('cities')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="10 China Cities Worth Your Time — City Travel Guides"
  description="In-depth travel guides to 10 Chinese cities Western visitors love: Beijing, Shanghai, Xi'an, Chengdu, Chongqing, Guangzhou, Shenzhen, Hangzhou, Guilin, and Zhangjiajie."
  canonicalPath="/cities/"
>
  <div class="container">
    <Breadcrumb
      crumbs={[
        { name: 'Home', url: '/' },
        { name: 'Cities', url: '/cities/' },
      ]}
    />

    <header class="page-header">
      <h1>10 China Cities Worth Your Time</h1>
      <p>We focus on the cities Western visitors actually go to — with practical, local-level detail.</p>
    </header>

    <div class="cities__grid">
      {cities.map((c) => (
        <a href={`/cities/${c.slug}/`} class="city-card">
          <div class="city-card__body">
            <h2>{c.data.nameEn}</h2>
            <p>{c.data.description}</p>
            <span class="city-card__more">City guide →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-header { margin: 1.5rem 0; }
  .page-header h1 { font-size: 2rem; margin: 0 0 0.5rem; }
  .page-header p { color: var(--muted); font-size: 1.05rem; margin: 0; }
  .cities__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .city-card {
    display: block;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.25rem;
    color: var(--text);
    background: var(--card-bg);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }
  .city-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); transform: translateY(-2px); text-decoration: none; }
  .city-card h2 { margin: 0 0 0.4rem; font-size: 1.2rem; }
  .city-card p { font-size: 0.88rem; color: var(--muted); margin: 0 0 0.75rem; }
  .city-card__more { color: var(--accent); font-weight: 600; font-size: 0.9rem; }
</style>
